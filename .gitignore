# Terraform working directories and downloaded providers
**/.terraform/*

# Terraform state
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Terraform plans and crash logs
*.tfplan
*.plan
tfplan
tfplan.json
crash.log
crash.*.log

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local CLI configuration
.terraformrc
terraform.rc

# Credentials generated by google-github-actions/auth
gha-creds-*.json

# Local cloud credential and private-key files
service-account-key*.json
*-credentials.json
*.pem
*.key

# Local environment files
.env
.env.*
!.env.example

# Python bytecode and cache directories
__pycache__/
*.py[cod]
.venv/
venv/

# Editor and operating-system files
.DS_Store
.idea/
.vscode/
*.swp
*.swo
